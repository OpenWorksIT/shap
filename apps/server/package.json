{
  "name": "@shap/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "import": "tsx --env-file-if-exists=../../.env src/db/import-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "create-owner": "tsx --env-file-if-exists=../../.env src/db/create-owner.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^10.1.6",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@node-rs/argon2": "^2.0.0",
    "@shap/shared": "*",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.17.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^5.0.5"
  }
}
