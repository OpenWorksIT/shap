<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later: the books go into the phone's Google backup only when that backup is
  end-to-end encrypted (the phone has a screen lock), and move across in a phone-to-phone transfer.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
