# Shap main server. Copy to .env, fill in, chmod 600.
# SPDX-License-Identifier: AGPL-3.0-or-later

# The address you'll open on your PC and phone. Point its DNS A record at this VPS first.
SHAP_DOMAIN=shap.example.co.za

# Make each of these with: openssl rand -base64 32
POSTGRES_PASSWORD=
SECRETS_KEY=

# Everyone sets up an authenticator app at first sign-in (recommended on a public server).
MFA_REQUIRED=true

# Stay signed in on your phone for this long without using Shap (hours). 720 = 30 days.
SESSION_TTL_HOURS=720

# Optional: email quotes and invoices straight from Shap (docs/deployment.md, "Email").
# smtps:// for port 465, smtp:// for 587. Write @ in the username as %40.
# SMTP_URL=smtps://invoices%40yourcompany.co.za:password@mail.yourcompany.co.za:465
# MAIL_FROM=Your Company <invoices@yourcompany.co.za>
