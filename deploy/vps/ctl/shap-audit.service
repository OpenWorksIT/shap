[Unit]
Description=Shap: the server's security and privacy check, shown in Settings → Updates & backups
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
# The results go where the app reads them (it mounts /var/lib/shap/ctl read-only).
ExecStart=/opt/shap/deploy/vps/audit-server.sh --quiet --json /var/lib/shap/ctl/audit.json
# "something to fix" is a result, not a failure of the service
SuccessExitStatus=1
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
# It reads the host's settings and changes nothing: keep it away from the rest of the system.
ProtectSystem=full
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
